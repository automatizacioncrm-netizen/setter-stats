-    asignado: API_MASTER_INDEX_ANY_(oh, ["Asignado"], true),
+    asignado: API_MASTER_INDEX_ANY_(oh, ["Asignado", "Asignado a"], true),
     creadoEl: API_MASTER_INDEX_ANY_(oh, ["Creado el"], true),
